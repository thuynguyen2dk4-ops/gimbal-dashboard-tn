{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/web/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web/user_dashboard.html",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/web/user_dashboard",
      "destination": "/account",
      "permanent": true
    },
    {
      "source": "/web/profile_edit.html",
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/web/profile_edit",
      "destination": "/profile",
      "permanent": true
    },
    {
      "source": "/web/admin_dashboard.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/web/admin_dashboard",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/web/mobile_app.html",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/web/mobile_app",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/web/vibe_studio.html",
      "destination": "/studio",
      "permanent": true
    },
    {
      "source": "/web/vibe_studio",
      "destination": "/studio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/account",
      "destination": "/web/user_dashboard.html"
    },
    {
      "source": "/id",
      "destination": "/web/user_dashboard.html"
    },
    {
      "source": "/user",
      "destination": "/web/user_dashboard.html"
    },
    {
      "source": "/profile",
      "destination": "/web/profile_edit.html"
    },
    {
      "source": "/account/edit",
      "destination": "/web/profile_edit.html"
    },
    {
      "source": "/admin",
      "destination": "/web/admin_dashboard.html"
    },
    {
      "source": "/app",
      "destination": "/web/mobile_app.html"
    },
    {
      "source": "/studio",
      "destination": "/web/vibe_studio.html"
    }
  ]
}